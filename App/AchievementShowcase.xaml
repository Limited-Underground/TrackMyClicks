<Window x:Class="TrackMyClicks.AchievementShowcase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackMyClicks · Achievement showcase" Width="1260" Height="900" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="16" Foreground="#F0F5FF"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="WindowKeyDown">
    <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B1723" Offset="0"/><GradientStop Color="#101A26" Offset="0.55"/><GradientStop Color="#0B1622" Offset="1"/></LinearGradientBrush></Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="MintBrush" Color="#27E6AF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B0C0D5"/>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172433" Offset="0"/><GradientStop Color="#111E2C" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D2D3E" Offset="0"/><GradientStop Color="#182635" Offset="1"/></LinearGradientBrush>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F5FF"/></Style>
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26E3AC"/><Setter Property="Foreground" Value="#07332D"/><Setter Property="BorderBrush" Value="#36EAB8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,11"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/><Setter TargetName="Surface" Property="BorderBrush" Value="#C6FFEE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MilestoneProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" ClipToBounds="True"><Border Background="#40546E" CornerRadius="4"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="BadgeTemplate">
            <Border x:Name="CardSurface" Width="342" MinHeight="205" Margin="0,0,14,14" Padding="17" Background="{StaticResource CardBrush}" BorderBrush="#2A4056" BorderThickness="1" CornerRadius="11">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="8" Background="#27394B" HorizontalAlignment="Left"><Path Data="{Binding TierGeometry}" Fill="{Binding AccentBrush}" Width="27" Height="27" Stretch="Uniform"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Tier}" Foreground="{Binding AccentBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,13,0,12"/>
                    <Grid Grid.Row="2" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProgressText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{Binding AccentBrush}" FontSize="12" VerticalAlignment="Top"/></Grid>
                    <ProgressBar Grid.Row="3" Style="{StaticResource MilestoneProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{Binding AccentBrush}" AutomationProperties.Name="{Binding Title}"/>
                    <TextBlock Grid.Row="4" Text="{Binding DetailText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsUnlocked}" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{Binding AccentBrush}"/><Setter TargetName="CardSurface" Property="Background" Value="#17322F"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ChallengeTemplate">
            <Border Padding="15" Margin="0,0,0,8" Background="{StaticResource CardBrush}" BorderBrush="#2A4056" BorderThickness="1" CornerRadius="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" MaxWidth="220"><TextBlock Text="{Binding StateText}" Foreground="{Binding AccentBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Right"/><TextBlock Text="{Binding DetailText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" HorizontalAlignment="Right"/></StackPanel><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ProgressText}" FontSize="13" Margin="0,10,0,7"/><ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MilestoneProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{Binding AccentBrush}" AutomationProperties.Name="{Binding Title}"/></Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="ShowcaseRoot" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid Margin="28,22,22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LIMITED UNDERGROUND  /  TRACKMYCLICKS" Foreground="{StaticResource MintBrush}" FontSize="12"/><TextBlock Text="Achievement showcase" FontSize="34" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Every Click Counts." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/></StackPanel><Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource BackButtonStyle}" Click="BackClick" VerticalAlignment="Center" Margin="18,0,6,0" AutomationProperties.Name="Back to dashboard"><StackPanel Orientation="Horizontal"><Path Data="M 10,1 L 2,9 10,17 M 2,9 L 20,9" Stroke="#07332D" StrokeThickness="2" Width="17" Height="16" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Back to dashboard" Foreground="#07332D" FontWeight="SemiBold"/></StackPanel></Button></Grid>
        <StackPanel Grid.Row="1" Margin="0,18,0,22"><TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap"/><WrapPanel Margin="0,13,0,0"><TextBlock Text="Bronze" Foreground="#DCA16F" Margin="0,0,24,0" FontSize="13"/><TextBlock Text="Silver" Foreground="#C6D4E4" Margin="0,0,24,0" FontSize="13"/><TextBlock Text="Gold" Foreground="#FFD15B" Margin="0,0,24,0" FontSize="13"/><TextBlock Text="Platinum" Foreground="#9CE5E1" Margin="0,0,24,0" FontSize="13"/><TextBlock Text="Diamond" Foreground="#85BCFF" FontSize="13"/></WrapPanel></StackPanel>
        <ScrollViewer x:Name="ShowcaseScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Focusable="False">
            <StackPanel Margin="0,0,6,0">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="#2B4056" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,0,0,24"><StackPanel><TextBlock Text="DAILY CHALLENGES &amp; REWARDS" FontWeight="Bold" FontSize="16"/><TextBlock Text="Today's optional goals and completed challenge badges. Take breaks; there is no need to complete every goal." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,15"/><ListBox x:Name="ChallengeItems" MaxHeight="355" Background="Transparent" BorderThickness="0" Padding="0" Foreground="#F0F5FF" ItemTemplate="{StaticResource ChallengeTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Daily challenge achievements"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#A8F8E0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></StackPanel></Border>
                <ItemsControl x:Name="CategoryGroups"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource BadgeTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Everything stays on this computer. Imported badges retain their original history; dates that were never recorded remain unknown." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
