<Window x:Class="TrackMyClicks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackMyClicks · Every Click Counts." Width="1710" Height="919"
        MinWidth="900" MinHeight="700" FontFamily="Segoe UI" FontSize="16"
        Foreground="#F0F5FF" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1723" Offset="0"/>
            <GradientStop Color="#101A26" Offset="0.55"/>
            <GradientStop Color="#0B1622" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="MintBrush" Color="#27E6AF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B0C0D5"/>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172433" Offset="0"/>
            <GradientStop Color="#111E2C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D2D3E" Offset="0"/>
            <GradientStop Color="#182635" Offset="1"/>
        </LinearGradientBrush>
        <Geometry x:Key="PauseGeometry">M 1,0 L 5,0 5,15 1,15 Z M 9,0 L 13,0 13,15 9,15 Z</Geometry>
        <Geometry x:Key="PlayGeometry">M 1,0 L 14,8 1,16 Z</Geometry>
        <Geometry x:Key="StarGeometry">M 16,1 L 20.5,10.4 31,11.9 23.4,19.2 25.2,29.5 16,24.6 6.8,29.5 8.6,19.2 1,11.9 11.5,10.4 Z</Geometry>
        <Geometry x:Key="TrophyGeometry">M 8,2 L 24,2 24,8 C 24,15 21,19 17,20 L 17,25 23,25 23,29 9,29 9,25 15,25 15,20 C 11,19 8,15 8,8 Z M 8,5 L 3,5 3,9 C 3,14 6,16 11,16 M 24,5 L 29,5 29,9 C 29,14 26,16 21,16</Geometry>
        <Geometry x:Key="GearGeometry">M 13,1 L 19,1 20,5 23,6 27,4 31,8 29,12 30,15 34,16 34,22 30,23 29,26 31,30 27,34 23,32 20,33 19,37 13,37 12,33 9,32 5,34 1,30 3,26 2,23 -2,22 -2,16 2,15 3,12 1,8 5,4 9,6 12,5 Z M 16,12 A 7,7 0 1 0 16,26 A 7,7 0 1 0 16,12</Geometry>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F5FF"/>
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="BorderBrush" Value="#2B4056"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        </Style>
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EFF6FF"/>
            <Setter Property="Background" Value="#182737"/>
            <Setter Property="BorderBrush" Value="#2D455C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A8F8E0"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MintBrush}"/><Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="SettingCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F5FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="24" Height="24" CornerRadius="2" BorderThickness="2" BorderBrush="#A5B5C8" Background="#172331" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                        <Path x:Name="Tick" Data="M 2,8 L 7,13 17,2" Width="15" Height="12" Stretch="Fill" Stroke="#082134" StrokeThickness="2.5" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#22B4ED"/><Setter TargetName="Box" Property="BorderBrush" Value="#22B4ED"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#45E6C3"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#A8F8E0"/><Setter TargetName="Box" Property="BorderThickness" Value="3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MilestoneProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="#20DDDA"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" ClipToBounds="True">
                    <Border Background="#40546E" CornerRadius="4"/>
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="MetricRow" TargetType="Border"><Setter Property="Height" Value="56"/><Setter Property="BorderBrush" Value="#243548"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
        <Style x:Key="InsightTile" TargetType="Border" BasedOn="{StaticResource PanelStyle}"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Height" Value="64"/></Style>
        <Style x:Key="InsightLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="InsightValue" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MintBrush}"/><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <ScrollViewer Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Focusable="False">
        <Grid x:Name="RootLayout" Margin="32,22,32,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="LIMITED UNDERGROUND  /  EXPERIMENTAL V0.3" Foreground="{StaticResource MintBrush}" FontSize="16"/>
                <TextBlock Text="TrackMyClicks" FontSize="54" FontWeight="Bold" Margin="0,1,0,0"/>
                <TextBlock Text="Every Click Counts." Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,1,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,20,0,20">
                <Button x:Name="PauseButton" Style="{StaticResource ControlButton}" Background="#26E3AC" Foreground="#062C29" BorderBrush="#36EAB8" Click="PauseClick" AutomationProperties.Name="Pause tracking">
                    <StackPanel Orientation="Horizontal"><Path x:Name="PauseIcon" Data="{StaticResource PauseGeometry}" Fill="#063C33" Width="14" Height="15" Stretch="Uniform" Margin="0,0,13,0"/><TextBlock x:Name="PauseLabel" Text="Pause tracking" Foreground="#07332D" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ControlButton}" Click="TrayClick" Margin="10,0,0,0" AutomationProperties.Name="Minimize to tray">
                    <StackPanel Orientation="Horizontal"><Path Data="M 4,2 L 18,2 21,7 21,16 1,16 1,7 Z M 1,10 L 6,10 8,13 14,13 16,10 21,10 M 5,2 L 5,7 M 17,2 L 17,7" Stroke="#DFEAF6" StrokeThickness="1.5" Width="18" Height="17" Stretch="Uniform" Margin="0,0,11,0"/><TextBlock Text="Minimize to tray" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Ellipse x:Name="StatusIndicator" Fill="{StaticResource MintBrush}" Width="14" Height="14" Margin="32,0,13,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Tracking locally" Foreground="{StaticResource MintBrush}" FontSize="16" VerticalAlignment="Center"/>
                <WrapPanel Margin="24,6,0,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource InsightTile}" Width="164"><StackPanel><TextBlock Text="ACTIVE DAY STREAK" Style="{StaticResource InsightLabel}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="StreakCurrentText" Text="0 days" Style="{StaticResource InsightValue}"/><StackPanel Margin="14,5,0,0"><TextBlock Text="Longest" Style="{StaticResource InsightLabel}"/><TextBlock x:Name="StreakLongestText" Text="0 days" FontSize="12"/></StackPanel></StackPanel></StackPanel></Border>
                    <Border Style="{StaticResource InsightTile}" Width="140"><StackPanel><TextBlock Text="CLICKS · LAST 60s" Style="{StaticResource InsightLabel}"/><TextBlock x:Name="ClickRateText" Text="0" Style="{StaticResource InsightValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource InsightTile}" Width="140"><StackPanel><TextBlock Text="BEST CLICKS / MIN" Style="{StaticResource InsightLabel}"/><TextBlock x:Name="ClickRateBestText" Text="0" Style="{StaticResource InsightValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource InsightTile}" Width="118" Margin="0"><StackPanel><TextBlock Text="REWARD POINTS" Style="{StaticResource InsightLabel}"/><TextBlock x:Name="RewardPointsText" Text="0" Style="{StaticResource InsightValue}"/></StackPanel></Border>
                </WrapPanel>
            </WrapPanel>
            <Grid x:Name="MainDashboard" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="DashboardLeftColumn" Width="1.46*"/><ColumnDefinition Width="24"/><ColumnDefinition x:Name="DashboardRightColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DashboardRightRow" Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="LeftStack" Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="ActivityPanel" Style="{StaticResource PanelStyle}" Padding="16,18,16,22" MinHeight="576">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,17">
                                <Path Data="M 0,23 L 6,23 6,12 0,12 Z M 9,23 L 15,23 15,5 9,5 Z M 18,23 L 24,23 24,0 18,0 Z" Fill="{StaticResource MintBrush}" Width="25" Height="25" Stretch="Uniform" Margin="0,0,22,0"/>
                                <TextBlock Text="YOUR ACTIVITY" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Background="#142232" BorderBrush="#23364A" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                                <StackPanel>
                                    <Border Height="52" Background="#1C2D3F" CornerRadius="10,10,0,0" BorderBrush="#2B3C50" BorderThickness="0,0,0,1">
                                        <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="29*"/><ColumnDefinition Width="27*"/></Grid.ColumnDefinitions><TextBlock Text="Metric" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Today" Foreground="{StaticResource MintBrush}" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Lifetime" Foreground="#25BFFF" FontSize="18" VerticalAlignment="Center"/></Grid>
                                    </Border>
                                    <Border Style="{StaticResource MetricRow}"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="29*"/><ColumnDefinition Width="27*"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="26" Height="30" HorizontalAlignment="Left" Margin="16,0,0,0"><Canvas Width="24" Height="30"><Path Data="M 12,1 C 5,1 2,5 2,12 L 2,20 C 2,26 6,29 12,29 C 18,29 22,26 22,20 L 22,12 C 22,5 19,1 12,1 Z M 12,1 L 12,13 22,13" Stroke="#29B9F4" StrokeThickness="2.5"/><Path Data="M 12,2 C 5,2 3,6 3,12 L 12,12 Z" Fill="#29B9F4"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Left clicks" Style="{StaticResource MetricLabel}"/></Grid><TextBlock x:Name="LeftToday" Grid.Column="1" Text="0" Style="{StaticResource MetricValue}"/><TextBlock x:Name="LeftLifetime" Grid.Column="2" Text="0" Style="{StaticResource MetricValue}"/></Grid></Border>
                                    <Border Style="{StaticResource MetricRow}" Background="#152434"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="29*"/><ColumnDefinition Width="27*"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="26" Height="30" HorizontalAlignment="Left" Margin="16,0,0,0"><Canvas Width="24" Height="30"><Path Data="M 12,1 C 5,1 2,5 2,12 L 2,20 C 2,26 6,29 12,29 C 18,29 22,26 22,20 L 22,12 C 22,5 19,1 12,1 Z M 12,1 L 12,13 22,13" Stroke="#FF6F84" StrokeThickness="2.5"/><Path Data="M 12,2 C 19,2 21,6 21,12 L 12,12 Z" Fill="#FF6F84"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Right clicks" Style="{StaticResource MetricLabel}"/></Grid><TextBlock x:Name="RightToday" Grid.Column="1" Text="0" Style="{StaticResource MetricValue}"/><TextBlock x:Name="RightLifetime" Grid.Column="2" Text="0" Style="{StaticResource MetricValue}"/></Grid></Border>
                                    <Border Style="{StaticResource MetricRow}"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="29*"/><ColumnDefinition Width="27*"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="26" Height="30" HorizontalAlignment="Left" Margin="16,0,0,0"><Canvas Width="24" Height="30"><Path Data="M 12,1 C 5,1 2,5 2,12 L 2,20 C 2,26 6,29 12,29 C 18,29 22,26 22,20 L 22,12 C 22,5 19,1 12,1 Z M 12,1 L 12,13 22,13" Stroke="#FFCE4D" StrokeThickness="2.5"/><Path Data="M 12,2 C 19,2 21,6 21,12 L 12,12 Z" Fill="#FFCE4D"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Middle clicks" Style="{StaticResource MetricLabel}"/></Grid><TextBlock x:Name="MiddleToday" Grid.Column="1" Text="0" Style="{StaticResource MetricValue}"/><TextBlock x:Name="MiddleLifetime" Grid.Column="2" Text="0" Style="{StaticResource MetricValue}"/></Grid></Border>
                                    <Border Style="{StaticResource MetricRow}" Background="#152434"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="29*"/><ColumnDefinition Width="27*"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 1,3 L 29,3 29,22 1,22 Z M 5,8 L 8,8 M 11,8 L 14,8 M 17,8 L 20,8 M 23,8 L 26,8 M 5,12 L 8,12 M 11,12 L 14,12 M 17,12 L 20,12 M 23,12 L 26,12 M 7,17 L 23,17" Stroke="#B25BFA" StrokeThickness="2.5" StrokeLineJoin="Round" Width="30" Height="25" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0"/><TextBlock Grid.Column="1" Text="Keyboard presses" Style="{StaticResource MetricLabel}"/></Grid><TextBlock x:Name="KeysToday" Grid.Column="1" Text="0" Style="{StaticResource MetricValue}"/><TextBlock x:Name="KeysLifetime" Grid.Column="2" Text="0" Style="{StaticResource MetricValue}"/></Grid></Border>
                                    <Border Style="{StaticResource MetricRow}"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="29*"/><ColumnDefinition Width="27*"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 1,0 L 1,27 8,20 13,30 18,27 13,18 23,18 Z" Fill="#26B8F3" Width="25" Height="30" Stretch="Uniform" HorizontalAlignment="Left" Margin="17,0,0,0"/><TextBlock Grid.Column="1" Text="Pointer distance" Style="{StaticResource MetricLabel}"/></Grid><TextBlock x:Name="DistanceToday" Grid.Column="1" Text="0.0 ft" Style="{StaticResource MetricValue}"/><TextBlock x:Name="DistanceLifetime" Grid.Column="2" Text="0.0 ft" Style="{StaticResource MetricValue}"/></Grid></Border>
                                    <Border Style="{StaticResource MetricRow}" Background="#152434" BorderThickness="0"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="29*"/><ColumnDefinition Width="27*"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="26" Height="30" HorizontalAlignment="Left" Margin="16,0,0,0"><Canvas Width="24" Height="30"><Path Data="M 12,1 C 5,1 2,5 2,12 L 2,20 C 2,26 6,29 12,29 C 18,29 22,26 22,20 L 22,12 C 22,5 19,1 12,1 Z M 12,1 L 12,14" Stroke="#25E4F1" StrokeThickness="2.5"/><Path Data="M 9,6 L 15,6 15,12 9,12 Z" Fill="#25E4F1"/></Canvas></Viewbox><TextBlock Grid.Column="1" Text="Wheel notches" Style="{StaticResource MetricLabel}"/></Grid><TextBlock x:Name="ScrollToday" Grid.Column="1" Text="0.0" Style="{StaticResource MetricValue}"/><TextBlock x:Name="ScrollLifetime" Grid.Column="2" Text="0.0" Style="{StaticResource MetricValue}"/></Grid></Border>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                                <Border Background="#24374B" CornerRadius="4" Width="40" Height="30"><Path Data="M 2,5 L 24,5 24,26 2,26 Z M 7,1 L 7,9 M 19,1 L 19,9 M 2,11 L 24,11 M 7,15 L 10,15 M 14,15 L 17,15 M 7,20 L 10,20 M 14,20 L 17,20" Stroke="#BED0E3" StrokeThickness="2" Width="23" Height="25" Stretch="Uniform"/></Border>
                                <TextBlock x:Name="DateText" Foreground="{StaticResource MutedBrush}" FontSize="15" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="20" Margin="0,20,0,0">
                        <StackPanel><TextBlock Text="DAILY CHALLENGES" FontWeight="Bold" FontSize="18"/><TextBlock Text="Three optional goals for your normal day. Take breaks; skipping a goal is always fine." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,17"/>
                            <ItemsControl x:Name="DailyChallengeCards" AutomationProperties.Name="Today's three challenges"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                <Border x:Name="DailyChallengeSurface" Background="{StaticResource CardBrush}" BorderBrush="#2A4056" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,8,0" MinHeight="174">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/><TextBlock Grid.Row="2" Text="{Binding StateText}" Foreground="{Binding AccentBrush}" FontSize="12" VerticalAlignment="Bottom" TextWrapping="Wrap"/><TextBlock Grid.Row="3" Text="{Binding ProgressText}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,7"/><StackPanel Grid.Row="4"><ProgressBar Style="{StaticResource MilestoneProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{Binding AccentBrush}" AutomationProperties.Name="{Binding Title}"/><TextBlock Text="{Binding DetailText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid>
                                </Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsUnlocked}" Value="True"><Setter TargetName="DailyChallengeSurface" Property="BorderBrush" Value="#27CBA3"/><Setter TargetName="DailyChallengeSurface" Property="Background" Value="#173B38"/></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="21,17" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="M 10,1 A 9,9 0 0 1 15,17 L 15,22 5,22 5,17 A 9,9 0 0 1 10,1 M 5,26 L 15,26 M 7,30 L 13,30" Stroke="#27E6AF" StrokeThickness="2" Width="22" Height="31" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><WrapPanel><TextBlock Text="ACTIVITY FACT" Foreground="{StaticResource MintBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="· refreshes every 30 seconds" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,1,0,0"/></WrapPanel><TextBlock x:Name="FunnyFactText" Text="Every click starts somewhere. Your local activity facts will grow with your totals." FontSize="15" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                    <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path Data="M 5,10 L 5,6 A 5,5 0 0 1 15,6 L 15,10 M 2,10 L 18,10 18,23 2,23 Z M 10,15 L 10,19" Stroke="#AFC1D7" Fill="#AFC1D7" StrokeThickness="2" Width="15" Height="19" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,2,0,0"/>
                        <StackPanel Grid.Column="1"><TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13"><Run Text="LOCAL &amp; PRIVATE  ·  "/><Run Text="No key identities, typed content, screenshots or application history stored."/></TextBlock><TextBlock x:Name="SaveText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                </Grid>
                <Grid x:Name="RightStack" Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource PanelStyle}" Padding="14,14,14,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="12,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource TrophyGeometry}" Stroke="#F0F5FF" Fill="#F0F5FF" StrokeThickness="1" Width="27" Height="28" Stretch="Uniform" Margin="0,0,23,0"/><TextBlock Grid.Column="1" Text="MILESTONES" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><Button x:Name="ShowAllButton" Grid.Column="2" Style="{StaticResource LinkButton}" Content="Show all →" Click="ShowAllClick" AutomationProperties.Name="Show all achievements"/></Grid>
                            <ScrollViewer x:Name="AchievementsScroller" Grid.Row="1" MaxHeight="276" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="AchievementCards">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border x:Name="AchievementSurface" Background="{StaticResource CardBrush}" CornerRadius="11" BorderBrush="#2A4056" BorderThickness="1" Margin="0,0,0,7" Padding="10,12,14,12" MinHeight="85">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border x:Name="BadgeBackground" Background="#27394B" CornerRadius="8" Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Path x:Name="BadgeIcon" Data="{StaticResource StarGeometry}" Fill="{Binding AccentBrush}" Width="29" Height="29" Stretch="Uniform"/>
                                                </Border>
                                                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding TierText}" Foreground="{Binding AccentBrush}" FontSize="11" Margin="8,3,0,0"/></Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="15" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="14" Margin="0,2,12,8" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PercentText}" FontSize="14" HorizontalAlignment="Right" Margin="0,2,0,8"/>
                                                    <ProgressBar x:Name="BadgeProgress" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MilestoneProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" AutomationProperties.Name="{Binding Title}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True"><Setter TargetName="AchievementSurface" Property="BorderBrush" Value="#27CBA3"/><Setter TargetName="AchievementSurface" Property="Background" Value="#173B38"/><Setter TargetName="BadgeProgress" Property="Foreground" Value="#27E6AF"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="26,17,24,17">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Path Data="{StaticResource GearGeometry}" Fill="#BFCDDF" Width="24" Height="24" Stretch="Uniform" Margin="0,0,24,0"/><TextBlock Text="SETTINGS" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
                            <CheckBox x:Name="Notifications" Style="{StaticResource SettingCheckBox}" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Achievement notifications"><StackPanel><TextBlock Text="Achievement notifications" FontSize="17"/><TextBlock Text="Show a notification when a milestone is reached." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></CheckBox>
                            <CheckBox x:Name="Metric" Style="{StaticResource SettingCheckBox}" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,10,0,0" AutomationProperties.Name="Use metric distance"><StackPanel><TextBlock Text="Use metric distance" FontSize="17"/><TextBlock Text="Display distance in meters/kilometers instead of feet/miles." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></CheckBox>
                            <Border Height="1" Background="#38506A" Margin="0,12,0,10"/>
                            <TextBlock Text="Pointer calibration (pixels / inch)" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                            <Grid Height="32" Margin="0,4,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="Calibration" Text="96" Foreground="#172331" Background="#F9FAFC" BorderBrush="#93A5BA" BorderThickness="1,1,0,1" Padding="9,3" FontSize="15" LostFocus="CalibrationChanged" AutomationProperties.Name="Pointer calibration, pixels per inch" ToolTip="Pixels per inch, from 1 to 10,000"/>
                                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Button x:Name="CalibrationIncrease" Tag="1" Click="CalibrationStepClick" Background="#E1E5EA" BorderBrush="#93A5BA" BorderThickness="0,1,1,0" Padding="0" AutomationProperties.Name="Increase pointer calibration"><Path Data="M 0,4 L 4,0 8,4" Stroke="#233341" StrokeThickness="1.5" Width="8" Height="4" Stretch="Uniform"/></Button><Button x:Name="CalibrationDecrease" Grid.Row="1" Tag="-1" Click="CalibrationStepClick" Background="#E1E5EA" BorderBrush="#93A5BA" BorderThickness="0,0,1,1" Padding="0" AutomationProperties.Name="Decrease pointer calibration"><Path Data="M 0,0 L 4,4 8,0" Stroke="#233341" StrokeThickness="1.5" Width="8" Height="4" Stretch="Uniform"/></Button></Grid>
                            </Grid>
                            <TextBlock Text="Estimated pointer travel. Calibration changes historical distance." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="4" Style="{StaticResource PanelStyle}" Padding="24,18,24,10">
                        <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Path Data="M 3,2 L 21,2 21,26 3,26 Z M 7,8 L 17,8 M 7,13 L 17,13 M 7,18 L 14,18" Stroke="#BFCDDF" StrokeThickness="2" Width="21" Height="25" Stretch="Uniform" Margin="0,0,18,0"/><TextBlock Text="PERSONAL RECORDS" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Your personal bests, with the local day achieved." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="PersonalRecordCards" AutomationProperties.Name="Personal activity records"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#2B3E53" BorderThickness="0,0,0,1" Padding="0,11,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" Margin="0,0,14,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" MaxWidth="220"><TextBlock Text="{Binding ValueText}" Foreground="{StaticResource MintBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>






